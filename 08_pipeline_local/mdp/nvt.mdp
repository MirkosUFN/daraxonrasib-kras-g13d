; NVT equilibration, 100 ps, position restraints on protein + ligand
define                  = -DPOSRES -DPOSRES_LIG
integrator              = md
dt                      = 0.002
nsteps                  = 50000
nstxout-compressed      = 500
nstenergy               = 500
nstlog                  = 500
continuation            = no
constraint_algorithm    = lincs
constraints             = h-bonds
lincs_iter              = 1
lincs_order             = 4
cutoff-scheme           = Verlet
nstlist                 = 10
ns_type                 = grid
coulombtype             = PME
pme_order               = 4
fourierspacing          = 0.12
rcoulomb                = 1.2
rvdw                    = 1.2
DispCorr                = EnerPres
tcoupl                  = V-rescale
tc-grps                 = Protein_LIG Water_and_ions
tau_t                   = 0.1     0.1
ref_t                   = 300     300
pcoupl                  = no
gen_vel                 = yes
gen_temp                = 300
gen_seed                = -1
pbc                     = xyz
