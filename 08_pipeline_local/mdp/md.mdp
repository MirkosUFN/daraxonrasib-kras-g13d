; Production MD — unrestrained. nsteps set by run_md.sh (--md-time)
integrator              = md
dt                      = 0.002
nsteps                  = 2500000        ; 5 ns default
nstxout-compressed      = 5000           ; 10 ps per frame
compressed-x-grps       = System
nstenergy               = 5000
nstlog                  = 5000
continuation            = yes
constraint_algorithm    = lincs
constraints             = h-bonds
lincs_iter              = 1
lincs_order             = 4
cutoff-scheme           = Verlet
nstlist                 = 10
ns_type                 = grid
coulombtype             = PME
pme_order               = 4
fourierspacing          = 0.12
rcoulomb                = 1.2
rvdw                    = 1.2
DispCorr                = EnerPres
tcoupl                  = V-rescale
tc-grps                 = Protein_LIG Water_and_ions
tau_t                   = 0.1     0.1
ref_t                   = 300     300
pcoupl                  = C-rescale
pcoupltype              = isotropic
tau_p                   = 2.0
ref_p                   = 1.0
compressibility         = 4.5e-5
gen_vel                 = no
pbc                     = xyz
