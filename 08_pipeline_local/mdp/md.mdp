; Production MD — unrestrained. nsteps set by run_md.sh (--md-time)
integrator              = md
dt                      = 0.002
nsteps                  = 100000000      ; 200 ns default (overridden by 02_run_md.sh)
nstxout-compressed      = 10000          ; 20 ps per frame -> 10,000 frames for 200 ns
compressed-x-grps       = System
nstenergy               = 10000
nstlog                  = 10000
continuation            = yes
constraint_algorithm    = lincs
constraints             = h-bonds
lincs_iter              = 1
lincs_order             = 4
cutoff-scheme           = Verlet
nstlist                 = 10
ns_type                 = grid
coulombtype             = PME
pme_order               = 4
fourierspacing          = 0.12
rcoulomb                = 1.2
rvdw                    = 1.2
DispCorr                = EnerPres
tcoupl                  = V-rescale
tc-grps                 = Protein_LIG Water_and_ions
tau_t                   = 0.1     0.1
ref_t                   = 300     300
pcoupl                  = C-rescale
pcoupltype              = isotropic
tau_p                   = 2.0
ref_p                   = 1.0
compressibility         = 4.5e-5
gen_vel                 = no
pbc                     = xyz
