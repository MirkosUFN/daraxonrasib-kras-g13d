; KRAS_G13D-4TQA — KRAS G13D (GDP, RAS-OFF) + CypA + docked daraxonrasib. Negative control: inactive state.
; Protein: AMBER99SB-ILDN | Water: TIP3P | Ligand & nucleotide: GAFF2/AM1-BCC (ACPYPE)
#include "amber99sb-ildn.ff/forcefield.itp"

; ---- GAFF2 atom types for DRG / GDP ----
#include "../../toppar/ligand_atomtypes.itp"

; ---- protein chains ----
#include "topol_Protein_chain_A.itp"
#include "topol_Protein_chain_B.itp"

; ---- daraxonrasib (DRG) and nucleotide (GDP) ----
#include "../../toppar/DRG.itp"
#ifdef POSRES_LIG
#include "posre_DRG.itp"
#endif
#include "../../toppar/GDP.itp"
#ifdef POSRES_LIG
#include "posre_GDP.itp"
#endif

#include "amber99sb-ildn.ff/tip3p.itp"
#ifdef POSRES_WATER
[ position_restraints ]
   1    1       1000       1000       1000
#endif

#include "amber99sb-ildn.ff/ions.itp"

[ system ]
KRAS_G13D-4TQA in water

[ molecules ]
; Compound          #mols
Protein_chain_A   1
Protein_chain_B   1
DRG               1
GDP               1
MG                1
